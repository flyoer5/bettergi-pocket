<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_log_body"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/sp_picker_drag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择点击位置"
            android:textColor="@color/overlay_log_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/sp_picker_close"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_overlay_close"
            android:contentDescription="关闭"
            android:padding="4dp"
            android:src="@drawable/ic_overlay_close"
            android:tint="@color/overlay_log_green" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="X 坐标"
            android:textColor="@color/overlay_text_muted"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/sp_picker_seek_x"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="90"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/sp_picker_x_text"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="50%"
            android:textColor="@color/overlay_log_green"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="Y 坐标"
            android:textColor="@color/overlay_text_muted"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/sp_picker_seek_y"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="90"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/sp_picker_y_text"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="99%"
            android:textColor="@color/overlay_log_green"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/sp_picker_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_overlay_close"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="测试"
            android:textColor="@color/overlay_log_green"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/sp_picker_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_overlay_close"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="确认"
            android:textColor="@color/overlay_log_green"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/sp_picker_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_overlay_close"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="取消"
            android:textColor="@color/overlay_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
