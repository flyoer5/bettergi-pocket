<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.miHoYo.Yuanshen" />
        <package android:name="com.miHoYo.ys.bilibili" />
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.miHoYo.cloudgames.ys" />
        <package android:name="com.miHoYo.cloudgames.GenshinImpact" />
        <package android:name="com.miHoYo.ys.mi" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:name=".PocketApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BetterGIPocket">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BetterGIPocket.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="bettergi"
                    android:host="p"
                    android:path="/launch" />
            </intent-filter>
        </activity>

        <activity
            android:name=".capture.CapturePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BetterGIPocket.Transparent" />

        <service
            android:name=".service.TriggerForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection" />

    </application>

</manifest>
